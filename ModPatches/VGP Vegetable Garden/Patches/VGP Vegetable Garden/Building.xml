<?xml version="1.0" encoding="utf-8" ?>
<!--VGP Vegetable Garden-->
<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VG_JellyFarm"]/researchPrerequisites</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VG_JellyFarm"]</xpath>
			<value>
				<researchPrerequisites>
					<li MayRequire="OskarPotocki.VFE.Tribals">VFET_Agriculture</li>
				</researchPrerequisites>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VG_FishTrap"]/researchPrerequisites</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VG_FishTrap"]</xpath>
			<value>
				<researchPrerequisites>
					<li MayRequire="Ludeon.RimWorld.Odyssey">Fishing</li>
				</researchPrerequisites>
			</value>
		</nomatch>
	</Operation>
</Patch>
